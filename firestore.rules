rules_version = '2';

// Mirrors the ADMIN_EMAILS list in index.html. Keep the two in sync —
// the array in the app only hides/shows UI, THIS is what actually
// enforces who can write to rooms/reservations as staff.
function isAdminEmail() {
  return request.auth != null &&
    request.auth.token.email in [
      "admin@staylink.com"
    ];
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Guest profile, preferences, loyalty balance, and vouchers.
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdminEmail());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // Room status (Available / Occupied / Cleaning).
    // Anyone (including signed-out guests browsing) can read live availability.
    // Only admin accounts can change it.
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isAdminEmail() ||
        (request.auth != null &&
         request.resource.data.availabilityCount >= 0 &&
         request.resource.data.status in ['Available', 'Occupied']);
      allow delete: if isAdminEmail();
      // Guests may only reserve or release one inventory unit. Admins retain
      // full control over status and inventory.
      allow update: if isAdminEmail() ||
        (request.auth != null &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['availabilityCount', 'status', 'updatedAt']) &&
         (request.resource.data.availabilityCount == resource.data.availabilityCount - 1 ||
          request.resource.data.availabilityCount == resource.data.availabilityCount + 1)) ||
        (request.auth != null &&
         resource.data.roomTypeId != null &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['bookings', 'status', 'updatedAt']) &&
         request.resource.data.status in ['Available', 'Occupied'] &&
         resource.data.status in ['Available', 'Occupied']);
    }

    // Reservations.
    // - A signed-in guest can create a reservation for themselves only
    //   (guestUid must match their own uid).
    // - A guest can read/update (e.g. cancel) only their own reservations.
    // - An admin can read and update any reservation.
    // - Nobody can delete a reservation (cancel = status update, keeps a record).
    match /reservations/{resId} {
      allow create: if request.auth != null
                    && request.resource.data.guestUid == request.auth.uid;

      allow read: if request.auth != null &&
                  (resource.data.guestUid == request.auth.uid || isAdminEmail());

      allow update: if request.auth != null &&
                    (resource.data.guestUid == request.auth.uid || isAdminEmail());

      allow delete: if false;
    }
  }
}
